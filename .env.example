# Pengyplexity — environment template
#
# The app reads its configuration from the *environment*, not from this file,
# so copy it and export it (or set these in your service manager):
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# Every value has a built-in default (see README → "Configuration"), so a
# minimal local run needs none of them. NEVER commit a real .env.

# ── Model endpoint ────────────────────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint. No model is bundled, so in
# practice this is the one thing you must point somewhere real.
PENGYPLEXITY_MODEL_BASE=http://127.0.0.1:8086/v1
PENGYPLEXITY_MODEL_KEY=
PENGYPLEXITY_MODEL_NAME=gpt-4o-mini
PENGYPLEXITY_MODEL_TEMPERATURE=0.3
PENGYPLEXITY_LLM_TIMEOUT=300

# ── Storage ───────────────────────────────────────────────────────────────
# Holds the stores, the sandbox venv and per-user workspaces.
PENGYPLEXITY_DATA_DIR=~/.pengyplexity
# PENGYPLEXITY_STORE=~/.pengyplexity/pengyplexity.bson

# ── Flask ─────────────────────────────────────────────────────────────────
# Generate one:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Sessions reset on every restart if you leave the development placeholder.
PENGYPLEXITY_SECRET_KEY=change-me-to-a-long-random-string
PENGYPLEXITY_DEBUG=0

# ── First admin ───────────────────────────────────────────────────────────
# Used only by `pengyplexity-admin create-admin` (there is no self-sign-up).
PENGYPLEXITY_ADMIN_PASSWORD=

# ── Agent limits ──────────────────────────────────────────────────────────
PENGYPLEXITY_MAX_AGENT_ITERATIONS=12
PENGYPLEXITY_RESEARCH_QUERY_BUDGET=6
PENGYPLEXITY_TOOL_OUTPUT_MAX_CHARS=250000
PENGYPLEXITY_DOWNLOAD_MAX_MB=100
PENGYPLEXITY_TOOL_NETWORK_TIMEOUT=15
PENGYPLEXITY_USER_AGENT=Mozilla/5.0 (Pengyplexity)

# ── Sandboxed execution (bubblewrap) ──────────────────────────────────────
PENGYPLEXITY_EXEC_TIMEOUT=30
PENGYPLEXITY_EXEC_MEM_BYTES=536870912
PENGYPLEXITY_EXEC_CPU_SECONDS=30
# PENGYPLEXITY_SANDBOX_VENV=~/.pengyplexity/sandbox-venv
PENGYPLEXITY_SANDBOX_AUTOBUILD=1

# ── Memory search ─────────────────────────────────────────────────────────
PENGYPLEXITY_MEMORY_SEMANTIC=1
PENGYPLEXITY_MEMORY_SIGNAL_FLOOR=0.33
PENGYPLEXITY_MEMORY_SIGNAL_CONFIDENT=0.50
