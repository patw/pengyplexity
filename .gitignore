# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
*.whl

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
sandbox-venv/

# ── Local configuration & secrets — NEVER commit ──────────────────────────
.env
.env.*
!.env.example
.secrets
secrets.json
*.pem
*.key
*.p12
*.pfx

# ── Pengyplexity runtime state (stores, workspaces, artifacts) ────────────
# Per-user data lives under PENGYPLEXITY_DATA_DIR (~/.pengyplexity by default,
# outside the repo) — these patterns catch an in-repo data dir.
.pengyplexity/
*.bson
*.bson.*
workspaces/
artifacts/

# ── Test & tooling caches ─────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml

# ── Logs & scratch ────────────────────────────────────────────────────────
*.log
logs/
*.tmp
*.bak
*.orig
*.rej

# ── Editors & IDEs ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ── OS noise ──────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
desktop.ini

# NOTE: uv.lock IS committed on purpose — this is an application, not a
# library, so the resolved dependency set should be reproducible.
